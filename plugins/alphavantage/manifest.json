{
  "name": "alphavantage",
  "version": "1.0.0",
  "description": "Alpha Vantage Core Stock Data APIs (time series, quotes, symbol search, and market status)",
  "entry": "./index.ts",
  "secrets": ["ALPHAVANTAGE_API_KEY"],
  "timeoutMs": 15000,
  "tools": [
    {
      "name": "time_series_intraday",
      "description": "Get current and historical intraday OHLCV time series for an equity, including optional extended hours (Premium)",
      "handler": "timeSeriesIntraday",
      "readOnly": true,
      "idempotent": true,
      "inputSchema": {
        "type": "object",
        "required": ["symbol", "interval"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "interval": { "type": "string", "enum": ["1min", "5min", "15min", "30min", "60min"] },
          "adjusted": { "type": "boolean" },
          "extended_hours": { "type": "boolean" },
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "outputsize": { "type": "string", "enum": ["compact", "full"] },
          "datatype": { "type": "string", "enum": ["json", "csv"] },
          "entitlement": { "type": "string", "enum": ["realtime", "delayed"] }
        },
        "additionalProperties": false
      },
      "cache": {
        "mode": "ttl",
        "ttlSeconds": 60,
        "tags": ["alphavantage"]
      }
    },
    {
      "name": "time_series_daily",
      "description": "Get raw (as-traded) daily OHLCV time series for a global equity",
      "handler": "timeSeriesDaily",
      "readOnly": true,
      "idempotent": true,
      "inputSchema": {
        "type": "object",
        "required": ["symbol"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "outputsize": { "type": "string", "enum": ["compact", "full"] },
          "datatype": { "type": "string", "enum": ["json", "csv"] }
        },
        "additionalProperties": false
      },
      "cache": {
        "mode": "ttl",
        "ttlSeconds": 300,
        "tags": ["alphavantage"]
      }
    },
    {
      "name": "time_series_daily_adjusted",
      "description": "Get daily OHLCV time series with adjusted close and historical split/dividend events (Premium)",
      "handler": "timeSeriesDailyAdjusted",
      "readOnly": true,
      "idempotent": true,
      "inputSchema": {
        "type": "object",
        "required": ["symbol"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "outputsize": { "type": "string", "enum": ["compact", "full"] },
          "datatype": { "type": "string", "enum": ["json", "csv"] },
          "entitlement": { "type": "string", "enum": ["realtime", "delayed"] }
        },
        "additionalProperties": false
      },
      "cache": {
        "mode": "ttl",
        "ttlSeconds": 300,
        "tags": ["alphavantage"]
      }
    },
    {
      "name": "time_series_weekly",
      "description": "Get weekly OHLCV time series for a global equity",
