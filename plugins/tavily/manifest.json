{
  "name": "tavily",
  "version": "1.0.0",
  "description": "Tavily Web Search, Content Extraction, Crawling, Mapping, and AI Research APIs",
  "entry": "./index.ts",
  "secrets": ["TAVILY_API_KEY"],
  "timeoutMs": 60000,
  "tools": [
    {
      "name": "search",
      "description": "Execute a real-time web search query optimized for AI agents and LLMs",
      "handler": "tavilySearch",
      "readOnly": true,
      "idempotent": true,
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "topic": { "type": "string", "enum": ["general", "news", "finance"] },
          "search_depth": { "type": "string", "enum": ["basic", "advanced", "fast", "ultra-fast"] },
          "chunks_per_source": { "type": "integer", "minimum": 1, "maximum": 3 },
          "max_results": { "type": "integer", "minimum": 1, "maximum": 20 },
          "time_range": { "type": "string", "enum": ["day", "week", "month", "year"] },
          "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "include_answer": { "type": ["boolean", "string"] },
          "include_raw_content": { "type": ["boolean", "string"] },
          "include_images": { "type": "boolean" },
          "include_image_descriptions": { "type": "boolean" },
          "include_favicon": { "type": "boolean" },
          "include_domains": { "type": "array", "items": { "type": "string" } },
          "exclude_domains": { "type": "array", "items": { "type": "string" } },
          "country": { "type": "string" }
        },
        "additionalProperties": false
      },
      "cache": {
        "mode": "ttl",
        "ttlSeconds": 300,
        "tags": ["tavily"]
      }
    },
    {
      "name": "extract",
      "description": "Extract clean web content from one URL or a batch of up to 20 URLs",
      "handler": "tavilyExtract",
      "readOnly": true,
      "idempotent": true,
      "inputSchema": {
        "type": "object",
        "required": ["urls"],
        "properties": {
          "urls": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1,
                "maxItems": 20
              }
            ]
          },
          "query": { "type": "string" },
          "chunks_per_source": { "type": "integer", "minimum": 1, "maximum": 5 },
          "extract_depth": { "type": "string", "enum": ["basic", "advanced"] },
          "format": { "type": "string", "enum": ["markdown", "text"] },
          "include_images": { "type": "boolean" },
          "include_favicon": { "type": "boolean" },
          "timeout": { "type": "number", "minimum": 1, "maximum": 60 }
        },
        "additionalProperties": false
      },
      "cache": {
        "mode": "ttl",
        "ttlSeconds": 300,
        "tags": ["tavily"]
      }
    },
    {
      "name": "crawl",
      "description": "Crawl a website in parallel using graph-based traversal with built-in content extraction",
      "handler": "tavilyCrawl",
      "readOnly": true,
      "idempotent": true,
      "inputSchema": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "instructions": { "type": "string" },
          "chunks_per_source": { "type": "integer", "minimum": 1, "maximum": 5 },
          "max_depth": { "type": "integer", "minimum": 1, "maximum": 5 },
          "max_breadth": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1 },
          "select_paths": { "type": "array", "items": { "type": "string" } },
          "select_domains": { "type": "array", "items": { "type": "string" } },
          "exclude_paths": { "type": "array", "items": { "type": "string" } },
          "exclude_domains": { "type": "array", "items": { "type": "string" } },
          "allow_external": { "type": "boolean" },
          "include_images": { "type": "boolean" },
          "extract_depth": { "type": "string", "enum": ["basic", "advanced"] },
          "format": { "type": "string", "enum": ["markdown", "text"] },
          "include_favicon": { "type": "boolean" },
          "timeout": { "type": "number", "minimum": 10, "maximum": 150 }
        },
        "additionalProperties": false
      },
      "cache": {
        "mode": "ttl",
        "ttlSeconds": 300,
        "tags": ["tavily"]
      }
    },
    {
      "name": "map",
      "description": "Map a website's URL structure and discover paths in parallel",
      "handler": "tavilyMap",
      "readOnly": true,
      "idempotent": true,
      "inputSchema": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "instructions": { "type": "string" },
          "max_depth": { "type": "integer", "minimum": 1, "maximum": 5 },
          "max_breadth": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1 },
          "select_paths": { "type": "array", "items": { "type": "string" } },
          "select_domains": { "type": "array", "items": { "type": "string" } },
          "exclude_paths": { "type": "array", "items": { "type": "string" } },
          "exclude_domains": { "type": "array", "items": { "type": "string" } },
          "allow_external": { "type": "boolean" },
          "timeout": { "type": "number", "minimum": 10, "maximum": 150 }
        },
        "additionalProperties": false
      },
      "cache": {
        "mode": "ttl",
        "ttlSeconds": 300,
        "tags": ["tavily"]
      }
    },
    {
      "name": "research",
      "description": "Initiate a comprehensive multi-step AI research task on a topic",
      "handler": "tavilyResearch",
      "readOnly": false,
      "idempotent": false,
      "inputSchema": {
        "type": "object",
        "required": ["input"],
        "properties": {
          "input": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "enum": ["mini", "pro", "auto"] },
          "output_schema": { "type": "object" },
          "citation_format": { "type": "string", "enum": ["numbered", "mla", "apa", "chicago"] }
        },
        "additionalProperties": false
      },
      "cache": {
        "mode": "off"
      }
    },
    {
      "name": "research_get",
      "description": "Retrieve the status and results of a Tavily research task by request_id",
      "handler": "tavilyResearchGet",
      "readOnly": true,
      "idempotent": true,
      "inputSchema": {
        "type": "object",
        "required": ["request_id"],
        "properties": {
          "request_id": { "type": "string", "minLength": 1 },
          "include_usage": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "cache": {
        "mode": "off"
      }
    }
  ]
}
